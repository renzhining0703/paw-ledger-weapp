/* 页面级 flex：内容少时也把「添加宠物」压到页底（对齐设计图），内容多时随内容滚动 */
.pl-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}
.pl-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(150, 120, 90, 0.07);
  transition: transform 0.12s ease, opacity 0.12s ease;
}
/* 整行按压态：只轻微下沉 + 变暗，不做位移，避免列表跳动 */
.pl-item-press { opacity: 0.9; transform: scale(0.99); }
/* 中间信息列允许收缩，防止右侧按钮把名字挤成竖排 */
.pl-item .flex-1 { min-width: 0; }
.pl-name {
  font-size: 32rpx; font-weight: 700;
  display: flex; align-items: center; gap: 12rpx;
  white-space: nowrap;
}
/* 共享角标（青色，紧贴名字，仅 memberCount>1 时展示） */
.pl-share {
  font-size: 22rpx; font-weight: 400;
  color: #1E9A80; background: #E7F7F2;
  padding: 4rpx 14rpx; border-radius: 14rpx;
  flex-shrink: 0;
}
.pl-info { font-size: 24rpx; color: var(--ink2); margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pl-arrow { font-size: 32rpx; color: var(--ink3); flex-shrink: 0; }

/* 行内快捷邀请按钮：原生 button 默认全宽（UA 样式），必须显式收窄 —— width/min-width/max-width 三件套都写 */
.pl-invite {
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 12rpx 26rpx;
  font-size: 26rpx; font-weight: 600; line-height: 1.4;
  color: var(--orange-deep); background: var(--orange-soft);
  border-radius: 999rpx; border: none;
  box-sizing: border-box;
}
.pl-invite::after { border: none; }
.pl-invite-press { opacity: 0.6; }

.pl-total { text-align: center; font-size: 24rpx; color: var(--ink3); margin: 24rpx 0 20rpx; }
/* 吸底添加按钮：内容少时 margin-top:auto 压到页底，内容多时 sticky 跟随 */
.pl-add { position: sticky; bottom: 32rpx; margin-top: auto; }
.pl-hint { text-align: center; font-size: 22rpx; color: var(--ink3); margin-top: 20rpx; }
.pl-empty { padding-top: 40rpx; }
