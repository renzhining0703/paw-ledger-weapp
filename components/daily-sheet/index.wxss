/* 记一条日常：项目胶囊 + 备注输入 */
.ds-picks {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ds-pick {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: var(--cream);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink2);
  border: 2rpx solid transparent;
}
.ds-pick.on {
  background: var(--orange-soft);
  border-color: var(--orange);
  color: var(--orange-deep);
  font-weight: 700;
}

/* 备注字段 */
.d-field { margin-top: 32rpx; }
.d-field-label { font-size: 26rpx; font-weight: 700; margin-bottom: 16rpx; }
.d-field-opt { font-size: 24rpx; font-weight: 400; color: var(--ink3); }
.d-field-input {
  background: var(--cream);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
}
.d-save { margin-top: 32rpx; }
