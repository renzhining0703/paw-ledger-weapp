/* 全屏裁剪层：fixed 定位显式四边（项目规约：禁用 inset: 简写） */
.ac-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  background: #1C1814;
  overflow: hidden;
}

/* 可拖动的原图：元素本身保持原尺寸，靠 transform 落位/缩放
   pointer-events: none —— 手势一律由根节点 catch* 统一处理，
   避免这张超大图（原图自然尺寸）盖住底部「使用 / 取消」按钮吃掉点击 */
.ac-img {
  position: absolute;
  top: 0;
  left: 0;
  transform-origin: 0 0;
  will-change: transform;
  pointer-events: none;
}

/* 圆形取景框：框内原色、框外压暗 */
.ac-frame {
  position: absolute;
  z-index: 1;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 0 9999px rgba(20, 16, 12, 0.58);
  pointer-events: none;
}

/* 顶部提示 */
.ac-tip {
  position: absolute;
  z-index: 2;
  right: 0;
  left: 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  pointer-events: none;
}

/* 底部操作条 */
.ac-bar {
  position: absolute;
  z-index: 3;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
}

.ac-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.ac-btn.ghost {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
}

.ac-btn.primary {
  background: var(--orange);
  color: #fff;
}

/* 小程序不支持 :active 伪类，点击反馈走 hover-class */
.ac-hover { opacity: 0.82; }

/* 离屏画布：移出视口但仍可绘制与导出 */
.ac-canvas {
  position: fixed;
  top: 0;
  left: -9999px;
}

.ac-out { opacity: 0; transition: opacity 0.2s ease; }
