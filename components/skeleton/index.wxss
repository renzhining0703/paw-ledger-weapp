.sk-anim {
  background: linear-gradient(90deg, #F2ECE4 25%, #FAF5EE 45%, #F2ECE4 65%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.2s infinite;
}
@keyframes sk-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.sk-card {
  display: flex;
  gap: 20rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.sk-card-sm {
  background: #fff;
  border-radius: 28rpx;
  padding: 22rpx;
}
.sk-line { height: 26rpx; border-radius: 8rpx; margin: 10rpx 0; }
.w20 { width: 20%; } .w30 { width: 30%; } .w40 { width: 40%; }
.w50 { width: 50%; } .w60 { width: 60%; } .w80 { width: 80%; } .w90 { width: 90%; }
.sk-ic { width: 64rpx; height: 64rpx; border-radius: 20rpx; flex-shrink: 0; }
.sk-line-row { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 8rpx; }
.sk-tl { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.sk-dot { width: 24rpx; height: 24rpx; border-radius: 50%; flex-shrink: 0; margin-top: 30rpx; }
